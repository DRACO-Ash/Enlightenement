# Secrets and local environment (never tracked)
.env
.env.local
.env.*.local

# Local data directories (the file-storage add-on provides these at runtime)
var/
data/

# Coverage and test artefacts
coverage.xml
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Tooling caches
.ruff_cache/
.mypy_cache/
.hypothesis/
__pycache__/
*.py[cod]
.venv/
venv/

# Agent worktrees: transient checkouts a subagent works in, removed when it finishes. Never
# tracked, because tracking them nests whole copies of the repository inside the repository and
# carries them into the App Store artefact.
.claude/worktrees/

# Packaging output
dist/
build/
*.egg-info/
enlightenment-appstore-*.zip

# Workstation-only UDL files. Neither belongs in the repository: the profile is an inventory of
# endpoints and field names, the credentials file is a credential, and queryhelp responses and raw
# record dumps stay on the machine that fetched them.
udl-profile.ini
credentials.ini
queryhelp-*.json
noise-model*.json

# `design/check-artboards.mjs` tells the operator to `npm install playwright` at the root, so
# following the instruction produces thousands of untracked third-party files that git then
# offers to commit. Same class as the worktree entry above: a tool's own working directory
# has no business being offered to the App Store artefact.
node_modules/

# The real thresholds. `content/thresholds.example.json` SHIPS and is deliberately not the
# operational values; the local copy replaces it and must never be committed. The redaction
# discipline lives here: a threshold in source is a threshold published. The loader refuses to
# serve a scored scenario until this file exists and declares its placeholders replaced.
content/thresholds.local.json
